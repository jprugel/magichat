# Generated by Cargo
/target/

# If using Rustup and you want to ignore toolchains
/.rustup/

# If using Clippy, Rustfmt, etc. and don’t want to track config
**/*.rs.bk

# Optional: IntelliJ / VS Code settings
.idea/
/.vscode/

# Optional: Backup files
*~
*.swp
*.bak

# Optional: By Cargo package publishing
/Cargo.lock
